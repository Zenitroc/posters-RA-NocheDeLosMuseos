{
  "name": "proyectos-que-cobran-vida",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma WebAR de la Noche de los Museos — Departamento de Ingeniería en Sistemas de Información, UTN FRBA",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/proyectos-validar.ts && tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/pruebas/e2e-camara-simulada.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "proyecto:nuevo": "node scripts/proyecto-nuevo.ts",
    "proyecto:preparar": "node scripts/proyecto-preparar.ts",
    "proyectos:validar": "node scripts/proyectos-validar.ts",
    "qr": "node scripts/generar-qr.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "mind-ar": "^1.2.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "three": "^0.186.1"
  },
  "overrides": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^2.8.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas": "^3.2.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "image-size": "^2.0.4",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "mp4-muxer": "^5.2.2",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
